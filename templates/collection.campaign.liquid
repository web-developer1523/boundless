{% assign campaign_handle = request.path | split: '/' | last %} 
{% comment %} {% assign campaign = shop.metaobjects.campaign[campaign_handle] %} {% endcomment %} 
{% assign campaign_info = collection.metafields.custom.campaign.value %}
{% comment %}
  Hide charity amount on specific collections. One handle or multiple (comma-separated).
  Example: 'sale' or 'sale, clearance, no-charity'
{% endcomment %}
{% assign hide_charity_collection_handles = 'spectrum-academy-t-shirt-design-contest' | split: ',' %}
{% assign show_charity_amount = true %}
{% for handle in hide_charity_collection_handles %}
  {% assign trimmed = handle | strip %}
  {% if collection.handle == trimmed %}
    {% assign show_charity_amount = false %}
    {% break %}
  {% endif %}
{% endfor %}
{% comment %} Hero background: 1280px for mobile, 2560px for desktop (sharp on all devices) {% endcomment %}
{% assign hero_bg_mobile = collection.featured_image | image_url: width: 1080 %}
{% assign hero_bg_desktop = collection.featured_image | image_url: width: 1900 %}

<section class="campaign-hero">
    <div class="campaign-hero__content">
      <h1>{{ campaign_info.name }}</h1>
      <p class="campaign-name">{{ campaign_info.hero_copy | metafield_tag | replace:'<p>','' | replace: '</p>', ''}}</p> 
    </div>
    <div class="campaign-btns">
      <div class="campaign-btns__slot campaign-btns__slot--brand">
        {% if campaign_info.brand.value %}
          <a href="/pages/brand/{{ campaign_info.brand.value.slug }}" class="btn">About This Brand</a>
        {% endif %}
      </div>
      <div class="campaign-btns__slot campaign-btns__slot--cause">
        {% if campaign_info.cause.value %}
          <a href="/pages/cause/{{ campaign_info.cause.value.slug }}" class="btn">About This Cause</a>
        {% endif %}
      </div>
    </div>
</section>

{% comment %} {{ campaign_brand_info.brand.value.default_brand_pct | json}} {% endcomment %}
<!-- 2️⃣ Brand + Cause -->
{% comment %} <section class="campaign-partners">
    <div class="partner-card brand">
        <img width="{{ campaign_info.brand.value.logo.width }}" height="{{ campaign_info.brand.value.logo.height }}" src="{{ campaign_info.brand.value.logo | image_url }}" />
        <h2>{{campaign_info.brand.value.name}}</h2>
        {{ campaign_info.brand.value.description | metafield_tag}} 
        <a href="/pages/brand/{{ campaign_info.brand.value.slug }}" class="btn">View Brand</a> 
        {% comment %} <a href="#" class="btn">View Brand</a> {% endcomment %}
    </div>

    <div class="partner-card cause">
        <img width="{{ campaign_info.cause.value.logo.width }}" height="{{ campaign_info.cause.value.logo.height }}" src="{{ campaign_info.cause.value.logo | image_url }}" />
        <h2>{{ campaign_info.cause.value.name }}</h2>
        {{ campaign_info.cause.value.description | metafield_tag }} {% comment %}
        <a href="/pages/cause/{{ campaign_info.cause.value.slug }}" class="btn">View Cause</a> {% endcomment %}
        <a href="#" class="btn">View Cause</a>
    </div>
</section> {% endcomment %}

<!-- 4️⃣ Products -->
{% assign products_per_page = 24 %}
{% paginate collection.products by products_per_page %}
<section
  class="campaign-products"
  id="campaign-products-section"
  data-collection-url="{{ collection.url }}"
  data-current-page="{{ paginate.current_page }}"
  data-last-page="{{ paginate.pages }}"
>
  <div class="impact-statement">{{ campaign_info.impact_statement | metafield_tag}}</div>
  {% comment %} <p class="campaign-product-count">{% if collection.products_count == 1 %}1 product{% else %}{{ collection.products_count }} products{% endif %}</p> {% endcomment %}
  <div class="product-grid" id="campaign-product-grid">
    {% for product in collection.products %}
    <div class="product-card" data-page="{{ paginate.current_page }}">
      <a href="{{ product.url | within: collection }}"><img src="{{ product.featured_image | image_url }}" /></a>
      <a href="{{ product.url | within: collection }}">{% if product.vendor != blank %}<p style="font-size:0.75em;text-transform:uppercase;letter-spacing:0.05em;margin:0 0 2px 0;">{{ product.vendor }}</p>{% endif %}
      <h3>{{ product.title }}</h3></a>
      <div class="price-combo"><p>{{ product.compare_at_price | money }}</p>
      <p>{{ product.price | money }}</p></div>
      {% assign cause_pct = campaign_info.cause.value.default_cause_pct | default: 0 %}
      {% if cause_pct > 0 and show_charity_amount %}
        {% assign charity_cents = product.price | times: cause_pct | divided_by: 100 %}
        <p class="charity-amount">{{ charity_cents | money }} straight to {{ campaign_info.cause.value.name }}</p>
      {% endif %}
      <a href="{{ product.url | within: collection }}" class="custom-btn">Add to Cart</a>
    </div>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}
  <div class="campaign-infinite-sentinel" id="campaign-infinite-sentinel" aria-hidden="true"></div>
  <p class="campaign-infinite-status" id="campaign-infinite-status" hidden></p>
  <p class="campaign-infinite-status campaign-infinite-status--done" id="campaign-infinite-done" hidden></p>
  {% endif %}
</section>
{% endpaginate %}

<script>
(function() {
  const section = document.getElementById('campaign-products-section');
  const grid = document.getElementById('campaign-product-grid');
  const sentinel = document.getElementById('campaign-infinite-sentinel');
  const statusEl = document.getElementById('campaign-infinite-status');
  const doneEl = document.getElementById('campaign-infinite-done');
  if (!section || !grid || !sentinel) return;

  let currentPage = parseInt(section.dataset.currentPage || '1', 10);
  const lastPage = parseInt(section.dataset.lastPage || '1', 10);
  const baseUrl = section.dataset.collectionUrl || '';
  let loading = false;

  if (currentPage >= lastPage) {
    sentinel.hidden = true;
    if (doneEl) doneEl.hidden = false;
    return;
  }

  const observer = new IntersectionObserver(
    function(entries) {
      if (loading || currentPage >= lastPage) return;
      if (!entries[0].isIntersecting) return;
      loadNextPage();
    },
    { rootMargin: '200px', threshold: 0 }
  );
  observer.observe(sentinel);

  async function loadNextPage() {
    loading = true;
    if (statusEl) statusEl.hidden = false;
    const nextPage = currentPage + 1;
    const url = baseUrl + (baseUrl.indexOf('?') >= 0 ? '&' : '?') + 'page=' + nextPage;
    try {
      const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const html = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const nextGrid = doc.getElementById('campaign-product-grid');
      if (nextGrid) {
        const cards = nextGrid.querySelectorAll('.product-card');
        cards.forEach(function(card) {
          grid.appendChild(document.importNode(card, true));
        });
      }
      currentPage = nextPage;
      history.replaceState(null, '', url);
      if (currentPage >= lastPage) {
        sentinel.hidden = true;
        if (statusEl) statusEl.hidden = true;
        if (doneEl) doneEl.hidden = false;
        observer.disconnect();
      }
    } catch (e) {
      if (statusEl) statusEl.textContent = 'Could not load more.';
    }
    loading = false;
  }
})();
</script>

<style>
  .price-combo {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: flex-start;
}

.price-combo p:first-child {
  text-decoration: line-through;
  opacity: 0.5;
}

.charity-amount {
  font-size: 13px;
  color: red;
  margin: 8px 0 12px 0;
  font-weight: 500;
}
/* Hero */
.impact-statement {
  text-align: center;
  padding-bottom: 50px;
  font-size: 18px;
}

.campaign-product-count {
  text-align: center;
  margin: 0 0 24px 0;
  font-size: 14px;
  color: #555;
}

.campaign-infinite-sentinel {
  height: 1px;
  width: 100%;
  visibility: hidden;
  pointer-events: none;
}

.campaign-infinite-status {
  text-align: center;
  margin: 24px 0;
  font-size: 14px;
  color: #666;
}

.campaign-infinite-status--done {
  color: #888;
}
.campaign-hero {
  background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
    url("{{ hero_bg_mobile }}") center / cover no-repeat;
  padding: 50px 20px;
  background-position: center top;
  color: #fff;
  height: 550px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
@media (min-width: 769px) {
  .campaign-hero {
    background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
      url("{{ hero_bg_desktop }}");
  }
}
.campaign-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  width: 100%;
}
.campaign-btns__slot--brand {
  justify-self: start;
}
.campaign-btns__slot--cause {
  justify-self: end;
}
.campaign-hero__content {
  max-width: 50%;
  width: 100%;
  margin: auto;
  text-align: center;
}

.campaign-hero h1 {
  font-size: 42px;
  margin-bottom: 12px;
}

.campaign-name {
  font-size: 18px;
  opacity: 0.9;
}

/* Brand + Cause */
.campaign-partners {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
  max-width: 1100px;
  margin: 0px auto;
  padding: 50px 20px;
}

.partner-card {
  background: #f8f8f8;
  padding: 32px;
  border-radius: 12px;
  text-align: center;
}

.partner-card img {
  max-height: 69px;
  margin-bottom: 20px;
  object-fit: contain;
}

.partner-card h2 {
  font-size: 26px;
  margin-bottom: 12px;
}

.partner-card p {
  font-size: 16px;
  margin-bottom: 20px;
  color: #555;
}

.btn {
  display: inline-block;
  padding: 10px 22px;
  border: 1px solid #fff;
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  border-radius: 4px;
}

.btn:hover {
  background: #fff;
  color: #000;
}

/* Impact */
.campaign-impact {
  background: #f1f4f6;
  padding: 50px 20px;
  text-align: center;
}

.campaign-impact p {
  max-width: 800px;
  margin: auto;
  font-size: 20px;
}

/* Products */
.campaign-products {
  max-width: 1200px;
  margin: 50px auto;
  padding: 0 20px;
}
.campaign-products h2 {
  font-size: 30px;
  margin-bottom: 50px;
  text-align: center;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 30px;
}

.product-card {
  border: 1px solid #eee;
  padding: 20px;
  border-radius: 8px;
  position: relative;
  padding-bottom: 80px;
}

.product-card img {
  width: 100%;
  height: auto;
  margin-bottom: 16px;
}

.product-card h3 {
  font-size: 18px;
  margin-bottom: 8px;
}

.price {
  font-weight: bold;
  margin-bottom: 12px;
}

.product-card button {
  background: #222;
  color: #fff;
  border: none;
  padding: 10px 16px;
  cursor: pointer;
  border-radius: 4px;
}
.custom-btn {
  padding: 10px 22px;
  border: 1px solid #222;
  color: #222;
  text-decoration: none;
  font-size: 14px;
  border-radius: 4px;
  text-transform: capitalize;
  margin-top: 0;
  position: absolute;
  bottom: 20px;
  width: 90%;
  text-align: left;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
}
.custom-btn:hover {
  background: #222;
  color: #fff;
}
.product-card h3 {
  font-size: 14px;
  font-weight: 500;
  text-align: left;
  line-height: 22px;
  color: #000;
}
.product-card a {
  display: block;
}

.product-card:hover img {
  transform: scale(1.1);
}

.product-card img {
  transition: all 0.3s;
}

.product-card:hover h3 {
  text-decoration: underline;
}

/* Mobile */
@media (max-width: 768px) {
  .campaign-partners {
      grid-template-columns: 1fr;
  }

  .campaign-hero h1 {
      font-size: 32px;
  }
  .campaign-hero__content{
    max-width:100%;
  }
}

</style>
    