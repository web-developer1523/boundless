{% assign campaigne_handle = request.path | split: '/' | last %}
{{ campaigne_handle }}
{% assign campaigne = shop.metaobjects.campaigne[campaigne_handle] %}

<section class="campaigne-section">
    <div class="campaigne-name">
        <h2>{{ campaigne.name }}</h2>
    </div>
    <div class="campaigne-logo-image">
        <img src="{{ campaigne.logo | image_url }}" alt="{{ campaigne.name }}">
    </div>
    <div class="campaigne-description">
        {{ campaigne.description | metafield_tag }}
    </div>
    <div class="campaigne-mission">
        {{ campaigne.mission_statement | metafield_tag}}
    </div>
    <div class="campaigne-category">
        {{ campaigne.category }}
    </div>
    <div class="campaigne-url">
        {{ campaigne.website_url }}
    </div>
    <div class="campaigne-default_campaigne_pct">
        {{ campaigne.default_campaigne_pct }}
    </div>
    <div class="campaigne-featured">
        {{ campaigne.featured }}
    </div>
    <div class="campaigne-active">
        {{ campaigne.active }}
    </div>

</section>

{% schema %}
{
    "name": "Campaign main section",
    "settings": [
    ],
    "presets": [
        {
            "name": "Campaign main section",
        }
    ]
}
{% endschema %}