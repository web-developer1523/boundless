{% liquid
  # If a collection_list setting exists keep its count behavior (preserves original authoring)
  if section.settings.collection_list != blank
    assign max_items = section.settings.collection_list.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  else
    assign max_items = 0
  endif
%}
  
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      color-{{ section.settings.color_scheme }}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: section.settings.gap %}
    "
  >
    <div class="section-resource-list__content">
      {%- content_for 'blocks' -%}
    </div>
    <div style="display:none" aria-hidden="true">
      {% content_for 'block', type: '_collection-card', id: 'static-collection-card' %}
    </div>
  
    {%- comment -%} Build unique brand list from collections' campaign metafields and render items {%- endcomment -%}
    {% assign valid_entries = '' %}
    {% for collection in collections %}
      {% assign campaign_info = collection.metafields.custom.campaign.value %}
      {% if campaign_info and campaign_info.brand %}
        {% assign b_handle = campaign_info.brand.value.handle %}
        {% if b_handle == nil %}
          {% assign b_handle = campaign_info.brand.value.name | downcase | replace: ' ', '-' | replace: '_', '-' | replace: '&', '' %}
        {% endif %}
        {% assign b_name = campaign_info.brand.value.name | default: b_handle %}
      
        {% unless valid_entries contains b_handle %}
          {% assign entry = b_handle | append: '::' | append: b_name %}
          {% if valid_entries == '' %}
            {% assign valid_entries = entry %}
          {% else %}
            {% assign valid_entries = valid_entries | append: ',' | append: entry %}
          {% endif %}
        {% endunless %}
      {% endif %}
    {% endfor %}

    {% assign valid_handles = valid_entries | split: ',' %}
    {% comment %} When using the carousel layout, show all discovered brands (override the earlier max_items cap) {% endcomment %}
    {% if section.settings.layout_type == 'carousel' %}
      {% assign max_items = valid_handles | size %}
    {% endif %}
    {% assign shown = 0 %}
    {% capture list_items %}
      {% for handle_entry in valid_handles %}
        {% if handle_entry != '' %}
          {% if shown > 0 %}<!--@list/split-->{% endif %}
          {% assign parts = handle_entry | split: '::' %}
          {% assign handle = parts[0] %}
          {% assign display_name = parts[1] | default: handle %}

          <div class="resource-list__item">
            {% assign brand_obj = shop.metaobjects.brand[handle] %}
        
            <a href="/pages/brand/{{ handle }}" class="brand-card" title="{{ brand_obj.name | default: display_name }}">
              <div class="brand-card__image">
                {% if brand_obj and brand_obj.logo %}
                  <img src="{{ brand_obj.logo | image_url }}" alt="{{ brand_obj.name }}" width="120" height="120" loading="lazy">
                {% endif %}
              </div>
              <div class="brand-card__title" style="text-align: center;">{{ brand_obj.name | default: display_name }}</div>
            </a>
          </div>

          {% assign shown = shown | plus: 1 %}
          {% if shown == max_items %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endcapture %}

    {% assign slide_count = shown %}
  
    {% liquid
      # Create an array from the list items to be used for different layout types
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}
  
    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionList',
      slide_count: slide_count,
      content_type: 'brands',
      test_id: 'brands-list-grid'
    %}
    {% if section.settings.show_button %}
      <div class="brand-list__cta" style="text-align:center; margin-top:16px;margin:0 auto;">
        <a href="{{ section.settings.button_url }}" class="button" aria-label="{{ section.settings.button_text }}">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
  
