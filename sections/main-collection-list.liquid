

{% liquid
  assign section_collections = collections
  # Show all collections by default (only non-empty collections are rendered).
  # Use the total collections size as the max to avoid unintentionally truncating results.
  assign max_items = collections | size
%}
{% comment %}
  Render unique campaign names (don't repeat duplicates).
  Uses a string accumulator `seen_campaigns` and `contains` check to filter repeats.
{% endcomment %}
{% comment %}
  Group collections by campaign and render:
  Campaign name:
  1) Collection name
{% endcomment %}
{% assign seen_campaigns = '' %}
{% assign seen_brands = '' %}
{% assign seen_causes = '' %}
{% for collection in collections %}
  {% assign campaign_info = collection.metafields.custom.campaign.value %}
  {% assign brand_info = collection.metafields.custom.brand.value %}
  {% assign cause_info = collection.metafields.custom.cause.value %}

  {%- comment -%}
    If brand/cause aren't set directly on the collection, fall back to values nested inside campaign metafield
  {%- endcomment -%}
  {% unless brand_info and brand_info.name %}
    {% if campaign_info and campaign_info.brand and campaign_info.brand.value and campaign_info.brand.value.name %}
      {% assign brand_info = campaign_info.brand.value %}
    {% endif %}
  {% endunless %}
  {% unless cause_info and cause_info.name %}
    {% if campaign_info and campaign_info.cause and campaign_info.cause.value and campaign_info.cause.value.name %}
      {% assign cause_info = campaign_info.cause.value %}
    {% endif %}
  {% endunless %}

  {% if campaign_info and campaign_info.name %}
    {% unless seen_campaigns contains campaign_info.name %}
      {% assign seen_campaigns = seen_campaigns | append: campaign_info.name | append: '||' %}
    {% endunless %}
  {% endif %}
  {% if brand_info and brand_info.name %}
    {% unless seen_brands contains brand_info.name %}
      {% assign seen_brands = seen_brands | append: brand_info.name | append: '||' %}
    {% endunless %}
  {% endif %}
  {% if cause_info and cause_info.name %}
    {% unless seen_causes contains cause_info.name %}
      {% assign seen_causes = seen_causes | append: cause_info.name | append: '||' %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% assign campaign_names = seen_campaigns | split: '||' %}
{% assign brand_names = seen_brands | split: '||' %}
{% assign cause_names = seen_causes | split: '||' %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}

    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% comment %} {% for collection in section_collections limit: max_items %}
      <div class="resource-list__item">
        {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %} {% endcomment %}
     {% assign shown = 0 %}

{% for collection in section_collections %}
  {% if collection.products_count > 0 %}
    
    {% if shown > 0 %}
      <!--@list/split-->
    {% endif %}

    {% assign campaign_info = collection.metafields.custom.campaign.value %}
    {% assign brand_info = collection.metafields.custom.brand.value %}
    {% assign cause_info = collection.metafields.custom.cause.value %}

    {% unless brand_info and brand_info.name %}
      {% if campaign_info and campaign_info.brand and campaign_info.brand.value and campaign_info.brand.value.name %}
        {% assign brand_info = campaign_info.brand.value %}
      {% endif %}
    {% endunless %}
    {% unless cause_info and cause_info.name %}
      {% if campaign_info and campaign_info.cause and campaign_info.cause.value and campaign_info.cause.value.name %}
        {% assign cause_info = campaign_info.cause.value %}
      {% endif %}
    {% endunless %}

    {% assign campaign_handle = '' %}
    {% assign brand_handle = '' %}
    {% assign cause_handle = '' %}
    {% if campaign_info and campaign_info.name %}
      {% assign campaign_handle = campaign_info.name | handleize %}
    {% endif %}
    {% if brand_info and brand_info.name %}
      {% assign brand_handle = brand_info.name | handleize %}
    {% endif %}
    {% if cause_info and cause_info.name %}
      {% assign cause_handle = cause_info.name | handleize %}
    {% endif %}

    <div class="resource-list__item" data-campaign-handle="{{ campaign_handle }}" data-brand-handle="{{ brand_handle }}" data-cause-handle="{{ cause_handle }}">
      {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
    </div>

    {% assign shown = shown | plus: 1 %}

    {% if shown == max_items %}
      {% break %}
    {% endif %}

  {% endif %}
{% endfor %}
  {% endcapture %}
  <style>
    /* container */
    .campaign-filter-wrapper {
      display: flex;
      justify-content: flex-end;
      margin: 18px 0;
      overflow-x: hidden; /* prevent accidental horizontal scroll from wide selects */
      width: 100%;
    }
    #campaign-filter-select, #brand-filter-select, #cause-filter-select {
      outline: none;
  }
    /* layout */
    .campaign-filter {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      width: 100%;
      justify-content: flex-end;
    }

    .campaign-filter-label {
      font-weight: 600;
      color: var(--color-foreground, #000);
      margin-right: 6px;
      flex: 0 0 auto;
    }

    /* select wrapper should be flexible but not force minimum width */
    .campaign-filter-select-wrap {
      position: relative;
      flex: 0 1 auto;
      min-width: 0; /* allow child to shrink properly inside flex */
    }

    /* selects: responsive sizing, box-sizing to include padding in width */
    #campaign-filter-select,
    #brand-filter-select,
    #cause-filter-select {
      width: 100%;
      max-width: 320px; /* reasonable desktop width */
      min-width: 0;
      padding: 10px 36px 10px 12px;
      border: 1px solid rgba(0,0,0,0.4);
      border-radius: 8px;
      background: var(--color-surface, #fff);
      box-shadow: 0 6px 18px rgba(16,24,40,0.04);
      font-size: 14px;
      color: inherit;
      appearance: none;
      box-sizing: border-box;
    }

    .campaign-filter-clear {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      font-size: 18px;
      line-height: 1;
      padding: 4px;
      cursor: pointer;
      color: rgba(0,0,0,0.35);
    }

    @media (max-width: 720px) {
      .campaign-filter-wrapper { justify-content: flex-start; padding: 0 12px; }
      .campaign-filter-select-wrap { flex: 1 1 100%; } /* make each select full-width on small screens */
      #campaign-filter-select,
      #brand-filter-select,
      #cause-filter-select {
        max-width: 100%;
      }
      .campaign-filter{
        justify-content: flex-start;
      }
    }
  </style>

  <div class="campaign-filter-wrapper">
    <div class="campaign-filter" role="region" aria-label="Collection filters">
      <span class="campaign-filter-label">Filter</span>

      <div class="campaign-filter-select-wrap" style="margin-right:6px;">
        <label for="campaign-filter-select" class="visually-hidden">Filter by campaign</label>
        <select id="campaign-filter-select" aria-label="Filter by campaign">
          <option value="">All campaigns</option>
          {% for campaign_name in campaign_names %}
            {% assign cn = campaign_name | strip %}
            {% if cn != '' %}
              <option value="{{ cn | handleize }}">{{ cn }}</option>
            {% endif %}
          {% endfor %}
        </select>
        <button id="campaign-filter-clear" class="campaign-filter-clear" aria-label="Clear campaign filter" title="Clear filter">&times;</button>
      </div>

      <div class="campaign-filter-select-wrap" style="margin-right:6px;">
        <label for="brand-filter-select" class="visually-hidden">Filter by brand</label>
        <select id="brand-filter-select" aria-label="Filter by brand">
          <option value="">All brands</option>
          {% for brand_name in brand_names %}
            {% assign bn = brand_name | strip %}
            {% if bn != '' %}
              <option value="{{ bn | handleize }}">{{ bn }}</option>
            {% endif %}
          {% endfor %}
        </select>
        <button id="brand-filter-clear" class="campaign-filter-clear" aria-label="Clear brand filter" title="Clear filter">&times;</button>
      </div>

      <div class="campaign-filter-select-wrap">
        <label for="cause-filter-select" class="visually-hidden">Filter by cause</label>
        <select id="cause-filter-select" aria-label="Filter by cause">
          <option value="">All causes</option>
          {% for cause_name in cause_names %}
            {% assign cn = cause_name | strip %}
            {% if cn != '' %}
              <option value="{{ cn | handleize }}">{{ cn }}</option>
            {% endif %}
          {% endfor %}
        </select>
        <button id="cause-filter-clear" class="campaign-filter-clear" aria-label="Clear cause filter" title="Clear filter">&times;</button>
      </div>

    </div>
  </div>

  <div id="campaign-empty-message" class="campaign-empty-message" style="display:none; text-align:center; padding:28px 0; color:var(--color-foreground-muted,#666);">
    No collections found for the selected filters.
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var campaignSelect = document.getElementById('campaign-filter-select');
    if (!campaignSelect) return;
    var brandSelect = document.getElementById('brand-filter-select');
    var causeSelect = document.getElementById('cause-filter-select');
    var campaignClear = document.getElementById('campaign-filter-clear');
    var brandClear = document.getElementById('brand-filter-clear');
    var causeClear = document.getElementById('cause-filter-clear');
    var messageEl = document.getElementById('campaign-empty-message');

    // Retry logic: resource-list may render items after this script runs.
    var attempts = 0;
    var maxAttempts = 15;
    var attemptDelay = 120; // ms

    function initWithItems(items) {
      function applyFilter(campaign, brand, cause) {
        items.forEach(function(it){
          var hCampaign = (it.getAttribute('data-campaign-handle') || '').toString().trim();
          var hBrand = (it.getAttribute('data-brand-handle') || '').toString().trim();
          var hCause = (it.getAttribute('data-cause-handle') || '').toString().trim();
          var show = true;
          if (campaign && campaign !== '' && hCampaign !== campaign) show = false;
          if (brand && brand !== '' && hBrand !== brand) show = false;
          if (cause && cause !== '' && hCause !== cause) show = false;
          it.style.display = show ? '' : 'none';
        });
        if (messageEl) {
          var visibleCount = items.reduce(function(acc, el){ return acc + (el.style.display !== 'none' ? 1 : 0); }, 0);
          messageEl.style.display = (visibleCount === 0) ? '' : 'none';
        }
      }

      function updateUrlParam(key, value) {
        try {
          if (!history.replaceState) return;
          var url = new URL(window.location);
          if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
          history.replaceState(null, '', url.toString());
        } catch (e) {}
      }

      function onChange() {
        var c = campaignSelect ? campaignSelect.value : '';
        var b = brandSelect ? brandSelect.value : '';
        var ca = causeSelect ? causeSelect.value : '';
        applyFilter(c, b, ca);
        updateUrlParam('campaign', c);
        updateUrlParam('brand', b);
        updateUrlParam('cause', ca);
      }

      if (campaignSelect) campaignSelect.addEventListener('change', onChange);
      if (brandSelect) brandSelect.addEventListener('change', onChange);
      if (causeSelect) causeSelect.addEventListener('change', onChange);

      if (campaignClear) {
        campaignClear.addEventListener('click', function(e){
          e.preventDefault();
          campaignSelect.value = '';
          campaignSelect.dispatchEvent(new Event('change'));
        });
      }
      if (brandClear) {
        brandClear.addEventListener('click', function(e){
          e.preventDefault();
          brandSelect.value = '';
          brandSelect.dispatchEvent(new Event('change'));
        });
      }
      if (causeClear) {
        causeClear.addEventListener('click', function(e){
          e.preventDefault();
          causeSelect.value = '';
          causeSelect.dispatchEvent(new Event('change'));
        });
      }

      // Apply initial filter from URL if present. Try both raw and handle values.
      try {
        var params = new URLSearchParams(window.location.search || '');
        var initCampaign = params.get('campaign');
        var initBrand = params.get('brand');
        var initCause = params.get('cause');

        function setInitial(selectEl, val) {
          if (!selectEl || !val) return '';
          var optionExists = Array.prototype.slice.call(selectEl.options).some(function(opt){ return opt.value === val; });
          if (optionExists) { selectEl.value = val; return val; }
          var handled = val.toString().trim();
          selectEl.value = handled;
          return handled;
        }

        var c = initCampaign ? setInitial(campaignSelect, initCampaign) : '';
        var b = initBrand ? setInitial(brandSelect, initBrand) : '';
        var ca = initCause ? setInitial(causeSelect, initCause) : '';
        applyFilter(c, b, ca);
      } catch(e){}
    }

    function findItemsAndInit() {
      var items = Array.prototype.slice.call(document.querySelectorAll('[data-campaign-handle]'));
      if ((items.length === 0) && attempts < maxAttempts) {
        attempts++;
        setTimeout(findItemsAndInit, attemptDelay);
        return;
      }
      initWithItems(items);
    }

    findItemsAndInit();
  });
  </script>

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'mainCollectionList',
    slide_count: max_items,
    content_type: 'collections',
    test_id: 'collections-list-grid'
  %}
</div>

{% schema %}
{
  "name": "t:names.collection_list",
  "class": "ui-test-collection-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "bento",
          "label": "t:options.bento"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "bento_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'bento' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'editorial' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
